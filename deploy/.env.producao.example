# Modelo do deploy/.env da VM de produção. Na primeira publicação, o deploy/vm/publicar.sh cria
# /opt/travus/compartilhado/.env a partir deste arquivo, com senha do Postgres, WORKER_TOKEN,
# CHAVE_CRIPTOGRAFIA, CHECKIN_WEBHOOK_SECRET e CHECKIN_DB_SENHA novos (e acrescenta os que
# faltarem em publicações seguintes). O arquivo fica só na VM. Guarde a CHAVE_CRIPTOGRAFIA fora da VM
# (gerenciador de senhas): sem ela, o token do Google no banco não decifra.

POSTGRES_USER=travus
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=travus

# Domínios: registros DNS do tipo A apontando para o IP da VM.
DOMINIO_APP=app.exemplo.com.br
DOMINIO_API=api.exemplo.com.br
# le-teste: certificado de teste do Let's Encrypt (não confiável, sem limite de emissões).
# Depois que o primeiro deploy funcionar, troque para le e publique de novo.
CERT_RESOLVER=le-teste

# Backup diário do Postgres na própria VM (cópia para fora: make backup-baixar).
BACKUP_DIR=/opt/travus/backups
BACKUP_HORA=3

# Alertas por e-mail. Gmail: smtp.gmail.com, porta 587, usuário = e-mail, senha = senha de app.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
ALERTA_DE=
# Um ou mais e-mails, separados por vírgula.
ALERTA_PARA=
# Monitor externo (ex.: healthchecks.io, verificação a cada 5 min): URL de ping.
VIGIA_PING_URL=

# Notificador de check-in (WhatsApp). O publicar.sh gera CHECKIN_WEBHOOK_SECRET (token que o PMS
# manda no cabeçalho x-webhook-token para https://DOMINIO_API/webhooks/nova-reserva) e
# CHECKIN_DB_SENHA. Grupo inicial (…@g.us), opcional: o admin escolhe o grupo pela tela.
CHECKIN_WHATSAPP_GROUP_JID=

# LANCE REAL: só "true" liga. Deixe false; ligue só na hora de registrar lances de verdade.
LANCE_REAL_HABILITADO=false

# Google Drive (opcional). O token vai para o banco com make google-token (docs/producao.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_PASTA_ID=
