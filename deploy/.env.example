# Copiado para deploy/.env pelo `make up` (com senha aleatória). deploy/.env fica fora do git.

POSTGRES_USER=travus
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=travus

# Token de serviço entre o worker e as rotas internas da API (mínimo 32 caracteres).
# O make gera e acrescenta WORKER_TOKEN ao deploy/.env se faltar.

# CHAVE_CRIPTOGRAFIA (64 caracteres hexadecimais) cifra no banco o token do Google Drive.
# O make gera e acrescenta ao deploy/.env se faltar. Guarde junto com o backup do banco:
# sem ela, o token importado não decifra.

# Notificador de check-in (WhatsApp). O make gera e acrescenta CHECKIN_WEBHOOK_SECRET (token que
# o PMS manda no cabeçalho x-webhook-token), CHECKIN_ADMIN_TOKEN (API → notificador: QR, grupos)
# e CHECKIN_DB_SENHA (papel checkin no Postgres) se faltarem. Localmente o serviço só sobe com make checkin.
# Grupo inicial (…@g.us), opcional: depois de parear, o admin escolhe o grupo pela tela.
CHECKIN_WHATSAPP_GROUP_JID=

# LANCE REAL: só "true" liga (na API e no worker). Deixe false; ligue só na hora de
# registrar lances de verdade, e desligue depois.
LANCE_REAL_HABILITADO=false

# Google Drive (opcional): client OAuth e ID da pasta dos comprovantes. O token vai para o
# banco com `make google-token`. Sem os três, os PDFs ficam só na plataforma.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_PASTA_ID=
