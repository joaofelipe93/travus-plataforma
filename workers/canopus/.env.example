# Copie este arquivo para .env e preencha os valores

# ---- Newcon ----
NEWCON_URL=https://cnp3.consorciocanopus.com.br/WWW/frmCorCcCnsLogin.aspx
NEWCON_USER=seu_usuario_aqui
NEWCON_PASS=sua_senha_aqui

# ---- Entrada ----
# Caminho do CSV com as cotas a processar. Colunas usadas: GRUPO, COTA e NOME
# (VERSAO é opcional, padrão 00). As demais colunas da planilha são ignoradas.
CSV_PATH=./cotasreal.csv

# ---- Google Drive ----
# ID da pasta do Drive onde os PDFs serão salvos.
# Pegue da URL da pasta: https://drive.google.com/drive/folders/AQUI_VAI_O_ID
DRIVE_FOLDER_ID=

# Client ID e Client Secret do OAuth Client (tipo "Desktop app")
# criado no Google Cloud Console. Veja README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Alternativa: caminho do credentials.json baixado do Google Cloud Console.
# Só é usado se GOOGLE_CLIENT_ID e GOOGLE_CLIENT_SECRET estiverem vazios.
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Arquivo onde o token OAuth persistente será salvo (gerado automaticamente).
GOOGLE_TOKEN_PATH=./token.json

# Porta fixa do retorno do OAuth (http://127.0.0.1:PORTA/oauth2callback).
# Obrigatória se o client for "Aplicativo da Web": cadastre essa URI no Console.
DRIVE_OAUTH_PORT=43117

# ---- Comportamento ----
# Segundos de timeout para cada ação do Playwright
PLAYWRIGHT_TIMEOUT_SECONDS=30

# Se true, abre o navegador (headed). Útil pra debugar.
HEADFUL=true

# Pasta local temporária para os PDFs antes do upload
DOWNLOAD_DIR=./downloads
SCREENSHOT_DIR=./screenshots
LOG_DIR=./logs
