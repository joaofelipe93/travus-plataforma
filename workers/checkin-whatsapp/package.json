{
  "name": "checkin-whatsapp",
  "version": "1.0.0",
  "description": "Recebe webhook de reserva e notifica check-in em um grupo do WhatsApp",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --experimental-test-module-mocks --disable-warning=ExperimentalWarning --test --test-concurrency=1 'tests/**/*.test.ts'",
    "test:watch": "npm test -- --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "license": "ISC",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "baileys": "^6.7.24",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "private": true
}
